ai:
  # Provider: openai | anthropic | ollama
  provider: openai
  model: gpt-4o-mini
  timeout_seconds: 120
  # base_url (openai provider only): override the endpoint to target any
  # OpenAI-compatible server — a self-hosted AI gateway, LiteLLM, vLLM, etc.
  # Include the version path (usually /v1). Omit to use OpenAI's cloud endpoint.
  # Put the gateway's key in .env as OPENAI_API_KEY.
  #   base_url: http://192.168.1.243:5010/v1
  # Required only when provider = ollama
  ollama_base_url: http://localhost:11434

dnsbl:
  lists:
  - zen.spamhaus.org
  - b.barracudacentral.org
  - bl.spamcop.net

imap:
  folder: INBOX
  host: imap.gmail.com
  port: 993
  # Folder to move messages into when action is MOVE_TO_JUNK (high/critical threat).
  # Gmail default: "[Gmail]/Spam". Other providers vary (e.g. "Junk" on Fastmail/Outlook).
  junk_folder: "[Gmail]/Spam"
  # Optional: move FLAG-level (medium threat) messages here instead of starring them.
  # Create this folder/label in your mail client first (e.g. a Gmail label "Suspect"),
  # then enter its exact IMAP name. Leave unset to use \Flagged (Gmail star) instead.
  # suspect_folder: "Suspect"

paths:
  db_file: /var/log/verdictmail/verdictmail.db
  log_backup_count: 5
  log_file: /var/log/verdictmail/verdictmail.log
  log_max_bytes: 10485760

startup_scan_limit: 20

thresholds:
  flag: 0.55
  junk: 0.8

# Graymail filter — routes unsolicited bulk/commercial mail (marketing/promotions,
# cold sales outreach, mass newsletters, notification digests) away from the inbox.
# This is a SEPARATE axis from the threat thresholds above and is OFF by default.
# Whitelisted senders are always exempt. Graymail at/above junk_threshold confidence
# is moved to Junk; between flag_threshold and junk_threshold it goes to Suspect.
graymail:
  enabled: false
  flag_threshold: 0.6    # → Suspect (borderline)
  junk_threshold: 0.85   # → Junk (confident)

timezone: UTC

# ui.password_hash and ui.secret_key are generated automatically on first run.
# Do not set them manually.
ui:
  password_hash: ''
  secret_key: ''

whitelist:
  enabled: true
  rules: []

# Blacklist: senders matched here skip analysis and move straight to the junk
# folder. Useful for senders that ignore unsubscribe/opt-out requests.
# Takes precedence over the whitelist. Same rule schema as the whitelist:
#   - sender: promo@spammer.com        # exact address
#     sender_domain: spammer.com       # any address at domain
#     subject_contains: limited offer  # case-insensitive substring
#     comment: Ignores opt-out
blacklist:
  enabled: true
  rules: []

worker_threads: 4
