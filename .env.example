# VerdictMail — environment variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# IMAP credentials (renamed from GMAIL_USERNAME/GMAIL_APP_PASSWORD in v0.3.0)
IMAP_USERNAME=your.address@example.com
IMAP_PASSWORD=xxxx xxxx xxxx xxxx

# AI provider API keys — only the key for your chosen provider is required.
# When ai.base_url points the openai provider at an OpenAI-compatible gateway,
# put the gateway's key here as OPENAI_API_KEY.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_API_KEY=

# URLhaus threat intelligence — optional
# Free API key from https://abuse.ch/ (register, then find your key under your profile)
URLHAUS_API_KEY=

# VirusTotal threat intelligence — optional
# Free API key from https://www.virustotal.com (register, then find your key under your profile)
VIRUSTOTAL_API_KEY=
